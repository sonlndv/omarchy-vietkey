#!/bin/bash
# VietKey setup: install the Unikey engine and configure fcitx5 for
# English + Vietnamese (Telex/VNI), switched with Ctrl+Shift.
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/fcitx5"
STAMP=$(date +%s)

if ! pacman -Q fcitx5-unikey &>/dev/null; then
  echo "Installing fcitx5-unikey..."
  omarchy pkg add fcitx5-unikey
fi

mkdir -p "$CONF/conf"
for f in profile config; do
  [[ -f $CONF/$f ]] && cp "$CONF/$f" "$CONF/$f.bak.$STAMP"
done

systemctl --user stop omarchy-fcitx5.service 2>/dev/null || pkill -x fcitx5 || true

cat >"$CONF/profile" <<'PROFILE'
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=unikey

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=unikey
Layout=

[GroupOrder]
0=Default
PROFILE

cat >"$CONF/config" <<'CONFIG'
[Behavior]
# One English/Vietnamese state for every window
ShareInputState=All
ActiveByDefault=False
ShowInputMethodInformation=True

# Ctrl+Shift is bound in Hyprland (below): fcitx5 misses modifier-only
# combos on Wayland. No fcitx5 trigger keys, and no lone-Shift switching.
[Hotkey]
TriggerKeys=
AltTriggerKeys=
CONFIG

if [[ ! -f $CONF/conf/unikey.conf ]]; then
  cat >"$CONF/conf/unikey.conf" <<'UNIKEY'
InputMethod=Telex
OutputCharset=Unicode
SpellCheck=True
Macro=False
AutoNonVnRestore=True
ModernStyle=True
FreeMarking=True
UNIKEY
fi

BINDINGS="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.lua"
if [[ -f $BINDINGS ]] && ! grep -q "vietkey:start" "$BINDINGS"; then
  cp "$BINDINGS" "$BINDINGS.bak.$STAMP"
  cat >>"$BINDINGS" <<'LUA'

-- vietkey:start
-- Ctrl+Shift (either order, either side) switches English <-> Vietnamese.
-- Fires on release and lets the keys through, so Ctrl+Shift+<key> still works.
for _, key in ipairs({ "Shift_L", "Shift_R", "Control_L", "Control_R" }) do
  o.bind("CTRL + SHIFT + " .. key, "VietKey: English / Vietnamese", "fcitx5-remote -t", { release = true, non_consuming = true })
end
-- vietkey:end
LUA
  hyprctl reload >/dev/null || true
fi

systemctl --user start omarchy-fcitx5.service 2>/dev/null || (setsid fcitx5 -d &>/dev/null &)
echo "VietKey ready: Ctrl+Shift switches English/Vietnamese; click the bar badge for the menu and Keyboard Settings."
